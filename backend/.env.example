# Server
PORT=4000
# Comma-separated list of allowed origins for the frontend
FRONTEND_ORIGIN=http://localhost:3000,https://www.cloudnetsoftwares.com,https://cloudnetsoftwares.com

# Auth
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=website_db

# SMTP (your info@cloudnetsoftwares.com mailbox) - used to email contact/reseller form submissions
# Get the host/port from your hosting control panel's Email Accounts / Connect Devices page.
SMTP_HOST=mail.cloudnetsoftwares.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@cloudnetsoftwares.com
SMTP_PASSWORD=your_mailbox_password_here

MAIL_FROM=CloudNet Softwares <info@cloudnetsoftwares.com>
MAIL_TO=cloudnetsoftwares@gmail.com
